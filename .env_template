# Copy to .env and fill in. Source before running examples:
#   source .env
#
# BOSDYN_CLIENT_USERNAME / BOSDYN_CLIENT_PASSWORD are read automatically by
# the SDK (see python/bosdyn-client/src/bosdyn/client/util.py).
# SPOT_IP is a convenience var to pass as the hostname positional arg, e.g.
#   python python/examples/hello_spot/hello_spot.py $SPOT_IP
# 192.168.80.3 is Spot's default address on its own wifi.

export BOSDYN_CLIENT_USERNAME=""
export BOSDYN_CLIENT_PASSWORD=""
export SPOT_IP="192.168.80.3"
